// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id                   String        @id @default(cuid())
  email                String        @unique
  passwordHash         String
  name                 String        @default("Merchant")
  phone                String?
  virtualAccountNumber String        @default("")
  bankName             String        @default("")
  createdAt            DateTime      @default(now())
  transactions         Transaction[]
}

model Transaction {
  id                     String    @id @default(cuid())
  direction              String    @default("incoming") // "incoming" or "outgoing"
  amount                 Int
  vaNumber               String?
  ussdString             String?
  status                 String    @default("pending")  // "pending", "confirmed", "failed", "expired"
  merchantId             String
  merchant               Merchant  @relation(fields: [merchantId], references: [id])
  senderName             String?
  recipientName          String?
  recipientBank          String?
  recipientAccountNumber String?
  reference              String    @unique @default(cuid())
  webhookRef             String?
  createdAt              DateTime  @default(now())
  confirmedAt            DateTime?

  @@index([vaNumber])
  @@index([status])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}